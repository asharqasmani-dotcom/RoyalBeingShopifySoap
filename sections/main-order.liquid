
<section class="section"><div class="page-width">
  <h1>Order {{ order.name }}</h1>
  <p>{{ order.created_at | date: '%B %d, %Y' }} · {{ order.financial_status_label }} · {{ order.fulfillment_status_label }}</p>
  <ul>{% for line_item in order.line_items %}<li>{{ line_item.title }} × {{ line_item.quantity }} — {{ line_item.final_line_price | money }}</li>{% endfor %}</ul>
  <p><strong>Total:</strong> {{ order.total_price | money }}</p>
</div></section>
{% schema %}{"name":"Order"}{% endschema %}
