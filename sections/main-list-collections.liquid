
<section class="page-banner"><div class="page-width"><h1>{{ section.settings.heading }}</h1><p>{{ section.settings.text }}</p></div></section>
<section class="section"><div class="page-width"><div class="grid grid-3">
{% for collection in collections %}
  {% unless collection.handle == 'all' or collection.handle == 'frontpage' %}
    {% render 'collection-card', collection: collection %}
  {% endunless %}
{% endfor %}
</div></div></section>

{% schema %}
{
  "name": "Collections list",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop all soaps"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Large, editorial product storytelling across five Royal Being collections."
    }
  ]
}
{% endschema %}
