
<section class="section">
  <div class="page-width">
    <div class="section-heading">
      <h2>{{ section.settings.heading }}</h2>
      {% if section.settings.text != blank %}<p>{{ section.settings.text }}</p>{% endif %}
    </div>
    <div class="video-block {% if section.settings.ratio == 'vertical' %}video-block--vertical{% else %}video-block--horizontal{% endif %}" data-video style="margin-top:28px">
      {% if section.settings.video != blank %}
        {{ section.settings.video | video_tag: image_size: '1600x', controls: true, muted: true }}
      {% elsif section.settings.external_url != blank %}
        <video playsinline controls muted preload="metadata" poster="{% if section.settings.poster != blank %}{{ section.settings.poster | image_url: width: 1600 }}{% endif %}">
          <source src="{{ section.settings.external_url }}" type="video/mp4">
        </video>
      {% elsif section.settings.poster != blank %}
        {{ section.settings.poster | image_url: width: 1600 | image_tag: loading: 'lazy', alt: section.settings.heading }}
      {% else %}
        {{ 'lifestyle-1' | placeholder_svg_tag }}
      {% endif %}
    </div>
    <div class="video-block__controls">
      <button type="button" class="button button--outline" data-video-play>Play</button>
      <button type="button" class="button button--outline" data-video-mute>Unmute</button>
    </div>
    {% if section.settings.transcript != blank %}
      <details class="accordion" style="max-width:800px;margin:20px auto 0"><summary>Transcript</summary><div class="accordion__content">{{ section.settings.transcript }}</div></details>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Video feature",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Royal Being film"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "A calm look at the ritual \u2014 muted by default, with accessible controls."
    },
    {
      "type": "select",
      "id": "ratio",
      "label": "Aspect",
      "options": [
        {
          "value": "horizontal",
          "label": "Horizontal"
        },
        {
          "value": "vertical",
          "label": "Vertical"
        }
      ],
      "default": "horizontal"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Shopify-hosted video"
    },
    {
      "type": "text",
      "id": "external_url",
      "label": "External MP4 URL (optional)"
    },
    {
      "type": "image_picker",
      "id": "poster",
      "label": "Poster image"
    },
    {
      "type": "textarea",
      "id": "transcript",
      "label": "Transcript"
    }
  ],
  "presets": [
    {
      "name": "Video feature"
    }
  ]
}
{% endschema %}
