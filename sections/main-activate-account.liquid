
<section class="section"><div class="page-width" style="max-width:480px;margin:0 auto">
  <h1>Activate account</h1>
  {% form 'activate_customer_password' %}
    <input class="field__input" type="password" name="customer[password]" placeholder="Password" required style="margin-bottom:12px">
    <input class="field__input" type="password" name="customer[password_confirmation]" placeholder="Confirm password" required>
    <button class="button button--primary" type="submit" style="margin-top:12px">Activate</button>
  {% endform %}
</div></section>
{% schema %}{"name":"Activate account"}{% endschema %}
