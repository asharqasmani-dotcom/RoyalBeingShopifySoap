
<section class="section" style="background:var(--rb-botanical);color:var(--rb-ivory)">
  <div class="page-width section-heading">
    <h2 style="color:var(--rb-ivory)">{{ section.settings.heading }}</h2>
    <p style="color:rgba(250,247,240,.9);margin-inline:auto">{{ section.settings.text }}</p>
    {% if section.settings.button_label != blank %}
      <div style="margin-top:22px"><a class="button button--outline-light" href="{{ section.settings.button_link }}">{{ section.settings.button_label }}</a></div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "CTA banner",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Begin the ritual"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Explore herbal soaps, subscriptions, and custom requests."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button",
      "default": "Shop all soaps"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Link"
    }
  ],
  "presets": [
    {
      "name": "CTA banner"
    }
  ]
}
{% endschema %}
