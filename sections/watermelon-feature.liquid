
<section class="section">
  <div class="page-width split">
    <div>
      <div class="product__collection">Signature collection</div>
      <h2>{{ section.settings.heading }}</h2>
      <p>{{ section.settings.text }}</p>
      <div class="video-block video-block--horizontal" data-video style="margin:20px 0">
        {% if section.settings.video != blank %}
          {{ section.settings.video | video_tag: image_size: '1400x', controls: true, muted: true }}
        {% elsif section.settings.external_url != blank %}
          <video playsinline controls muted preload="metadata" poster="{% if section.settings.poster != blank %}{{ section.settings.poster | image_url: width: 1400 }}{% endif %}">
            <source src="{{ section.settings.external_url }}" type="video/mp4">
          </video>
        {% elsif section.settings.poster != blank %}
          {{ section.settings.poster | image_url: width: 1400 | image_tag: loading: 'lazy', alt: 'Watermelon Fusion' }}
        {% endif %}
      </div>
      {% if section.settings.button_label != blank %}
        <a class="button button--primary" href="{{ section.settings.button_link }}">{{ section.settings.button_label }}</a>
      {% endif %}
    </div>
    <div>
      {% if section.settings.image != blank %}
        {{ section.settings.image | image_url: width: 1400 | image_tag: loading: 'lazy', alt: 'Watermelon Fusion schematics' }}
      {% endif %}
      <div class="ritual-block{% unless settings.publish_watermelon_ritual %} draft-hidden{% endunless %}" {% unless settings.publish_watermelon_ritual %}hidden{% endunless %}>
        <h2>The Ritual of Being</h2>
        <p>Indulge in the crisp opulence of a sun-drenched oasis. Watermelon Fusion marries the intensely hydrating, vitamin-rich essence of cold-pressed watermelon seed oil with the cooling touch of crushed wild mint and white tea.</p>
        <p>Hand-poured and aged in small batches, this ultra-nourishing artisanal spa bar transforms into a rich, velvety milk that gently polishes, deeply restores, and leaves the skin cloaked in a delicate, transcendent luminescence.</p>
        <p class="closing">Elevate your daily cleansing into a sacred spa ritual.</p>
      </div>
      {% unless settings.publish_watermelon_ritual %}
        <!-- Ritual copy gated until owner formula confirmation. See docs/CONFLICTS_AND_AUDIT.md -->
      {% endunless %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Watermelon feature",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Watermelon Fusion"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "A Signature Collection favorite \u2014 lush, refreshing, and crafted for a spa-like cleanse."
    },
    {
      "type": "video",
      "id": "video",
      "label": "Video"
    },
    {
      "type": "text",
      "id": "external_url",
      "label": "External MP4 URL"
    },
    {
      "type": "image_picker",
      "id": "poster",
      "label": "Poster"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Schematic / product image"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "CTA",
      "default": "Discover Watermelon Fusion"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "CTA link"
    }
  ],
  "presets": [
    {
      "name": "Watermelon feature"
    }
  ]
}
{% endschema %}
